rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Founders collection: founders can manage their own profile, content items, and memory
    match /founders/{founderId} {
      allow read, write: if request.auth != null && request.auth.uid == founderId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == founderId;
      }
    }

    // Public demo fallback
    match /public_profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
